{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "${command:cmake.buildType}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "增量编译"
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "cmake --preset ${command:cmake.buildType} . && cmake --build --preset ${command:cmake.buildType}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "detail": "重新配置并编译"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "${command:cmake.buildType}", "--target", "clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "清理编译产物"
        }
    ]
}
